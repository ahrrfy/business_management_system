<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".AlrueyaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlrueyaSuperApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.AlrueyaSuperApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                 قناةُ الإشعارات الأصيلة: intent مُنشَأ داخلياً من AlrueyaFirebaseMessagingService
                 عبر PendingIntent صريح. حذفنا فئة BROWSABLE (H2) لأنّها كانت تسمح لأيّ متصفّح
                 أو تطبيقٍ خارجيّ بفتح alrueya://app/... واستدراج المستخدم المصادَق إلى شاشات
                 حسّاسة (اعتماد صرف، تحرير مصروف). الإشعارات الداخليّة لا تحتاج BROWSABLE.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="app"
                    android:scheme="${notificationDeepLinkScheme}" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.notifications.AlrueyaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="${firebaseMessagingAutoInitEnabled}" />
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="${firebaseMessagingInstallationIdEnabled}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="business_updates" />
    </application>
</manifest>
