# ───────────────────────────────────────────────────────────────────────────
# قالب متغيّرات البيئة لنظام الرؤية العربية.
# انسخه إلى .env واملأ القيم:  copy .env.example .env   (Windows)
# ⚠ ملف .env الحقيقي مُستثنى من git — لا تضع أسراراً هنا، فقط أمثلة.
# ───────────────────────────────────────────────────────────────────────────

# البيئة: development | production
NODE_ENV=production

# منفذ خادم التطبيق
PORT=3000
# تشغيل Windows/localhost بلا Nginx: اربط الحلقة المحلية ولا تفرض سر proxy.
HOST=127.0.0.1
ALLOW_PUBLIC_BIND=0
REQUIRE_INTERNAL_PROXY_SECRET=0

# ── قاعدة البيانات (MySQL 8) ──────────────────────────────────────────────
# صيغة: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DB_APP_USER=erp_app
DB_APP_PW=CHANGE_ME_DIFFERENT_FROM_ROOT
DATABASE_URL=mysql://erp_app:CHANGE_ME_DIFFERENT_FROM_ROOT@127.0.0.1:3306/erp

# قاعدة الاختبارات (vitest) — منفصلة عن الإنتاج
TEST_DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/erp_test

# ── سرّ توقيع الجلسات (JWT) ───────────────────────────────────────────────
# ولّد سرّاً قويّاً (٦٤ خانة): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ── مستخدم admin الأوّل (يُنشأ بأمر seed) ─────────────────────────────────
ADMIN_EMAIL=admin@alroya.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# مطلوب فقط عند تشغيل `pnpm seed` التجريبي؛ يمنع حقن بيانات العينة بقاعدة حقيقية سهواً.
CONFIRM_SAMPLE_DATA_SEED=0

# ── النسخ الاحتياطي (scripts/backup.mjs + backup-rotate.mjs) ───────────────
# حاوية Docker لقاعدة البيانات وبيانات الاتصال للـmysqldump
DB_CONTAINER=erp-mysql
DB_NAME=erp
DB_ROOT_PW=CHANGE_ME
DB_PORT=3306

# مجلّد حفظ النسخ المحلّية (افتراضي backups/ المُستثنى من git)
BACKUP_DIR=backups

# سياسة الاحتفاظ (عدد النسخ المُبقاة في كل فئة)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# مجلّد النسخ الخارجي (OneDrive/USB) — اتركه فارغاً لتعطيله
# مثال Windows: BACKUP_OFFSITE_DIR=C:\Users\me\OneDrive\erp-backups
BACKUP_OFFSITE_DIR=

# مجلّد السجلّات (حارس Docker)
LOG_DIR=logs

# ── الاعتمادية والتسجيل والحماية (shared/errorMap + server/index + sentry) ──
# مستوى التسجيل: trace|debug|info|warn|error (افتراضي debug في dev، info في الإنتاج)
LOG_LEVEL=info

# مراقبة الأخطاء عبر Sentry — اتركها فارغة لتعطيلها (لا أثر إطلاقاً)
SENTRY_DSN_SERVER=
# DSN العميل يجب أن يبدأ بـVITE_ ليصل للمتصفّح (تحميل ديناميكي ⇒ ٠ أثر على الحزمة)
VITE_SENTRY_DSN_CLIENT=
SENTRY_TRACES_RATE=0

# أصول CORS المسموحة (مفصولة بفواصل) — اتركها فارغة للتشغيل أحادي الأصل
ALLOWED_ORIGINS=

# ── صور المنتجات الكاملة (Cloudflare R2 خاص) ───────────────────────────────
# الإنتاج يرفض سائق fs. أنشئ bucket خاصاً فقط (لا Public Access)، واضبط Bucket Lock مدة 90 يوماً
# لمساري single/studio/ وcompany- بلا lifecycle delete، وفق docs/media-storage-r2.md. لا تضع أسراراً في Git.
IMAGE_STORE_DRIVER=r2
R2_ACCOUNT_ID=
R2_IMAGE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_CONCURRENCY=4
R2_MAX_QUEUE=8
R2_QUEUE_TIMEOUT_MS=2000
R2_CIRCUIT_FAILURE_THRESHOLD=5
R2_CIRCUIT_OPEN_MS=30000
# المرآة الباردة الخارجية تراكمية (copy، لا sync). اترك المسار فارغاً في خادم التطبيق؛ تُشغّل
# الأداة من جهاز/قرص مستقل باعتماد R2 للقراءة فقط وبإقرار مؤقت في shell آمنة.
R2_COLD_MIRROR_DIR=
# single/studio/ للأحادي، أو company- لتغطية كل company-{id}/studio/ الحالية والمستقبلية.
R2_MIRROR_PREFIX=single/studio/
# restore-drill فقط: وجهة على filesystem device مستقل فعلياً عن جهاز المرآة؛ اختلاف المسار لا يكفي.
R2_DR_RESTORE_DIR=
R2_DR_SAMPLE_LIMIT=5
# GC تدقيقي فقط افتراضياً. لا تغيّر delete إلا لنافذة واعية بعد مرآة حديثة وإيصال restore-drill.
R2_GC_MODE=audit
R2_GC_DELETE_CONFIRM=
R2_GC_MIRROR_MANIFEST=
R2_GC_MIRROR_MANIFEST_SHA256=
R2_GC_DR_RECEIPT=
R2_GC_DR_RECEIPT_SHA256=
# متغيرا canary فقط ولا يقرأهما runtime التطبيق: مرّرهما مؤقتاً في shell آمنة ولا تحفظهما هنا:
# R2_CANARY_CONFIRM=RUN_PRIVATE_R2_CANARY
# R2_CANARY_CLOUDFLARE_API_TOKEN=<Account Workers R2 Storage Read token يقرأ domains/lock/lifecycle>
# R2_MIRROR_CONFIRM=RUN_CUMULATIVE_PRIVATE_R2_MIRROR
# التطوير فقط: IMAGE_STORE_DRIVER=fs و IMAGE_STORE_DIR=.image-store

# ── طلبات المتجر العامة (Cloudflare Turnstile Managed) ────────────────────
# تبقى مغلقة ما لم يُفعّل العلم صراحةً. عند STOREFRONT_ORDERING_ENABLED=1 يفشل
# إقلاع الخادم إذا كانت أي حلقة Turnstile أدناه ناقصة؛ لا سقوط صامت إلى طلبات بلا تحقق.
STOREFRONT_ORDERING_ENABLED=0
STOREFRONT_TURNSTILE_ENABLED=0
# مفتاح الموقع عام ويُعاد عبر storefront.settings؛ السر خادمي ولا يصل إلى المتصفح.
STOREFRONT_TURNSTILE_SITE_KEY=
STOREFRONT_TURNSTILE_SECRET_KEY=
# مضيفون دقيقون مفصولون بفاصلة؛ لا wildcard ولا scheme ولا path.
STOREFRONT_TURNSTILE_HOSTNAMES=alarabiya.online

# حدود معدّل الطلبات (لكل ١٥ دقيقة)
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=10

# ميزانية اتصالات آمنة أيضاً عند تفعيل تعدّد الشركات:
# عاملان × 10 قواعد ساخنة × 5 اتصالات + تجمّع التحكّم، ضمن 151 مع احتياطي 20.
WEB_INSTANCES=2
DB_POOL_LIMIT=5
DB_MAX_TENANT_POOLS_PER_WORKER=10
DB_TENANT_POOL_IDLE_MS=900000
MYSQL_MAX_CONNECTIONS=151
DB_CONNECTION_RESERVE=20
CONTROL_DB_POOL_LIMIT=5

# ── تعدّد الشركات (server/tenancy/) — اختياري، معطَّل افتراضياً ─────────────
# اتركه فارغاً/محذوفاً للنشر العادي أحادي الشركة (لا أثر إطلاقاً). لتفعيل عزل قاعدة بيانات
# فعلي لكل شركة (شركات شقيقة/بيع النظام كمنتج): اضبط CONTROL_DATABASE_URL (قاعدة تحكّم
# منفصلة تماماً عن DATABASE_URL، تحوي جدول الشركات وحسابات مدراء المنصّة)، شغّل
# `pnpm control:bootstrap` مرّة واحدة، ثم `pnpm company:new <رمز> "<اسم>" --admin-email .. --admin-password ..`
# لكل شركة (يُنشئ قاعدتها + مستخدم MySQL مخصّص أقلّ امتيازاً تلقائياً)، و`pnpm platform-admin:new`
# لحساب تشغيلي يدير الشركات عبر /platform-admin. التفصيل: ذاكرة multi-company-tenancy.
DB_CONTROL_NAME=
DB_CONTROL_USER=
DB_CONTROL_PW=
CONTROL_DATABASE_URL=

# مفتاح تشفير بيانات اتصال قاعدة كل شركة داخل قاعدة التحكّم (AES-256-GCM) — **إلزامي** إن
# ضبطتَ CONTROL_DATABASE_URL أعلاه (وإلا فشل فكّ بيانات اتصال الشركات). نفسه يُستعمل أيضاً
# لتشفير tokens التكاملات (WhatsApp/Instagram) — إن كنت تستعمل تلك الميزة فهو مُهيَّأ مسبقاً.
# ولّده بنفس طريقة JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=
# SHA-256 of the decoded 32-byte key, kept separately as a protected release variable.
INTEGRATIONS_ENCRYPTION_KEY_SHA256=

# ── إلزام المصادقة الثنائية (2FA) للمدير/المشرف — M9 ──────────────────────────
# مفعّل افتراضياً: الأدمن/المدير الذي لم يُفعّل 2FA يُحجب خادمياً عن كل إجراءٍ عدا التفعيل نفسه
# (ويُحجب واجهياً بشاشة التفعيل). لا إلزام إن كان INTEGRATIONS_ENCRYPTION_KEY غير مضبوط (لا يمكن
# التفعيل بلا مفتاح). 🛟 مخرج طوارئ للمالك: اضبطها `off` لتعطيل الإنفاذ كلياً إن تعذّر على مدير
# التفعيل وقُفِل خارج حسابه (أعِد التشغيل بعد التغيير). اتركها فارغة/غير مضبوطة = الإنفاذ فعّال.
TWO_FACTOR_ENFORCEMENT=

# ── إشعارات Web Push (Morning Brief) — server/services/pushService.ts ──────
# اتركها فارغة لتعطيل الميزة كليّاً (بلا أثر). لتفعيلها:
#  ١) ولّد زوج مفاتيح VAPID مرّة واحدة:
#     node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log('PUB='+k.publicKey+'\nPRV='+k.privateKey);"
#  ٢) ضع العام في VAPID_PUBLIC_KEY والخاص في VAPID_PRIVATE_KEY.
#  ٣) VAPID_SUBJECT بريد مسؤول (متصفّح Chrome يشترطه — الافتراضي admin@alroya.local يعمل).
# المفتاح الخاص سرّ مطلق — تسريبه يُتيح إرسال إشعارات مزوَّرة باسم الخادم.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alroya.local
# جدولة الإشعار الصباحي (cron خماسي، توقيت UTC). الافتراضي 04:00 UTC = 07:00 بغداد.
MORNING_PUSH_CRON=0 4 * * *

# ── إشعارات Android الأصلية (FCM HTTP v1) ───────────────────────────────
# JSON كامل لحساب خدمة Firebase؛ قيمة سرية لا تُحفظ في Git.
FCM_PROJECT_ID=
# Dedicated Firebase service account only (*.iam.gserviceaccount.com); legacy developer/appspot
# identities are intentionally not accepted by the Android production release gate.
FCM_SERVICE_ACCOUNT_JSON=

# ── جسر أجهزة الحضور الفيزيائي (عملية erp-hr-bridge المستقلة) ──────────────
# لا تعرّض المنفذ 7788 للإنترنت. في الإنتاج اربطه بعنوان LAN واضبط شبكة الأجهزة فقط.
HR_DEVICE_BRIDGE=
HR_DEVICE_PORT=7788
HR_DEVICE_HOST=
HR_DEVICE_IP_ALLOWLIST=
# سر اختياري للأجهزة/البوابة التي تدعم token في URL أو Authorization/X-Hr-Device-Secret.
HR_DEVICE_SHARED_SECRET=
# ربط كل SN بعنوان/شبكة ومفتاح خاص اختياري. مثال البنية فقط (لا تضع سراً حقيقياً في Git):
# {"SN123":{"allowlist":["192.168.10.20/32"],"sharedSecret":"<random-64-hex>"}}
HR_DEVICE_IDENTITY_BINDINGS=
# 1 للهجرة في بيئة غير إنتاجية فقط؛ الإنتاج والإصدار يرفضان أي قيمة غير 0.
HR_DEVICE_LEGACY_IDENTITY_MIGRATION=0
HR_DEVICE_MAX_PAYLOAD_BYTES=8388608
HR_DEVICE_REQUEST_TIMEOUT_MS=30000
HR_DEVICE_IDLE_TIMEOUT_MS=180000
HR_DEVICE_RATE_LIMIT_PER_MINUTE=240
# رسائل الجلسة بعد نجاح reg — منفصلة عن ميزانية الاتصال أعلاه كي لا يحجب تفريغُ المتراكم
# إعادةَ الاتصال (٣٠٠٠/دقيقة ≈ ٦٠ ألف بصمة/دقيقة).
HR_DEVICE_SESSION_RATE_LIMIT_PER_MINUTE=3000
HR_DEVICE_MAX_WS_PER_IP=4
# اعتماد العنوان التلقائيّ («تعلّم عنوان المتجر» بعد تدوير IP المزوّد) — يُغني عن تعديل allowlist
# يدوياً عند كل تدوير. مفعَّل افتراضياً؛ الإيقاف: HR_DEVICE_ORIGIN_AUTOTRUST=0.
HR_DEVICE_ORIGIN_AUTOTRUST=
# عدد جلسات الموظّفين المتمايزة من العنوان الجديد لاعتماده (شبكة عمل لا شبكة فرد). الافتراضي 2.
# =1 «ثِق بجلسةٍ واحدة»: تعافٍ أسرع (أوّل موظّفٍ يسجّل صباحاً بعد تدوير الليل) — قرارُ مالكٍ صريحٌ
# يقبل خطره (راجع originTrust.ts:42-52). لا يُقبل أقلّ من 1.
HR_DEVICE_ORIGIN_MIN_WITNESSES=
# نافذة اعتبار جلسة الموظّف قرينةً حيّة (ساعات، 1..720). الافتراضي 12.
HR_DEVICE_ORIGIN_TRUST_WINDOW_HOURS=

# ── جسر الطباعة الصامتة (server/services/printService.ts) ──────────────────
# وجهة الطباعة المباشرة لفواتير الكاشير دون حوار المتصفّح. اتركها فارغة لتعطيل الجسر
# (يتراجع العميل تلقائياً لـWebUSB ثم لحوار المتصفّح). الصيغ المدعومة:
#   tcp://<ip>[:<port>]   طابعة حرارية شبكية RAW (المنفذ الافتراضي 9100) — الأوثق، بلا تعريفات. (موصى به)
#   share://<ShareName>   طابعة Windows مشتركة بنوع RAW (شارِك طابعتك USB باسم ثم استعمله هنا)
# أمثلة:
#   PRINT_TARGET=tcp://192.168.1.50:9100
#   PRINT_TARGET=share://POS80
PRINT_TARGET=
