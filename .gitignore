# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
.runtime/

# Environment variables — استثناء كل ‎.env.* بقوّة (يشمل ‎.env.production الشائع)
# مع استثناء صريح للقوالب المنشورة فقط. سدّ فخّ التزام أسرار حيّة (تدقيق ١٤/٦/٢٦).
.env
.env.*
!.env.example
!.env.production.example

# IDE and editor files
.vscode/
.idea/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Coverage
coverage/

# Database dumps
*.db
*.sqlite
*.sqlite3

# Archived legacy (Manus) — reference only, not part of the clean repo
_legacy/

# Design assets bundle — reference only, not part of the app build
_design-bundle/

# Local Claude settings (workflows + launch.json are shared/committed)
.claude/settings.local.json
.claude/worktrees/
boot-diag.log

# Database backups (local dumps — keep off git)
backups/

# TWA / Android (Bubblewrap) — نُبقي إعداد twa-manifest.json فقط؛ نتجاهل مشروع أندرويد المولَّد
# ومفتاح التوقيع وحُزَم البناء (keystore/AAB/APK لا تُلتزم — أسرار + مخرجات بناء محلّية).
twa/*
!twa/twa-manifest.json

# Native Android — commit source and wrapper only; never commit local SDK state,
# signing material, Firebase credentials, or generated artifacts.
android-native/.gradle/
android-native/.kotlin/
android-native/**/build/
android-native/local.properties
android-native/app/google-services.json
android-native/**/*.jks
android-native/**/*.keystore
android-native/**/*.apk
android-native/**/*.aab
android-native/**/*.idsig

# Local emulator/screenshots/test evidence generated during native QA.
/artifacts/

# Image studio — أصول @imgly ML (استضافة ذاتية، تُهيَّأ مرّة، ~40MB، لا تُلتزم)
client/public/imgly-assets/

# Image studio — مخرجات سائق fs لـImageStore (جذر التطوير الافتراضيّ)
.image-store/
