{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "qa-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "qa-ios": {
      "distribution": "internal"
    },
    "play-internal": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
