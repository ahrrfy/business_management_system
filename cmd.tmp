ssh alroya-erp 'cd /home/deploy/erp && U=$(grep -m1 ^DATABASE_URL= .env | cut -d= -f2-) && C=${U#mysql://} && CR=${C%%@*} && RS=${C#*@} && DB=${RS#*/} && docker exec -i -e MYSQL_PWD=${CR#*:} erp-mysql mysql -u ${CR%%:*} -D ${DB%%\?*} -e "DELETE FROM __drizzle_migrations WHERE id=277 AND created_at=1782890000000 LIMIT 1; SELECT COUNT(*) cnt, MAX(created_at) mx FROM __drizzle_migrations;"'