    "db:migrate": "drizzle-kit migrate",
    "db:push": "node scripts/db-push-guard.mjs",
    "seed": "cross-env NODE_ENV=development SEED_MODE=sample TZ=UTC tsx server/seed.ts",
    "seed:demo-channels": "cross-env NODE_ENV=development TZ=UTC tsx scripts/demo-seed-channels.ts",
    "seed:prod": "cross-env NODE_ENV=production SEED_MODE=prod TZ=UTC tsx server/seed.ts",
