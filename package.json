    "start": "cross-env NODE_ENV=production TZ=UTC node dist/index.js",
    "check": "tsc --noEmit",
    "check:emoji": "node scripts/check-no-emoji-ui.mjs",
    "check:tashkeel": "node scripts/check-tashkeel-in-small-text.mjs",
    "check:money-schemas": "node scripts/check-money-schemas.mjs",
    "check:form-inputs": "node scripts/check-form-inputs.mjs",
    "check:branch": "node scripts/check-branch-default.mjs",
    "check:migrations": "node scripts/check-migration-journal.mjs",
    "check:schema-drift": "node scripts/check-migration-schema-drift.mjs --selftest && node scripts/check-migration-schema-drift.mjs",
    "check:orphans": "node scripts/check-orphan-endpoints.mjs",
    "catalog:report-name-issues": "node scripts/report-product-name-issues.mjs",
    "check:date-boundaries": "node scripts/check-date-boundaries.mjs --selftest && node scripts/check-date-boundaries.mjs",
    "check:colors": "node scripts/check-no-raw-status-colors.mjs",
    "audit:filters": "node scripts/audit-list-filters.mjs",
    "audit:actions": "node scripts/audit-row-actions.mjs",
    "audit:bundle": "node scripts/audit-build-budgets.mjs",
    "check:authz": "node scripts/authz-inventory.mjs --check",
    "check:authz:diff": "node scripts/authz-guard-diff.mjs",
