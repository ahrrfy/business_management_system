    "platform-admin:new": "node scripts/platform-admin-new.mjs",
    "admin:recover": "tsx scripts/recover-last-admin.ts",
    "db:migrate:all-companies": "node scripts/migrate-all-companies.mjs",
    "coord": "node scripts/coord.mjs",
    "coord:claim": "node scripts/coord.mjs claim",
    "coord:release": "node scripts/coord.mjs release",
    "coord:list": "node scripts/coord.mjs list",
    "coord:status": "node scripts/coord.mjs status",
    "coord:heartbeat": "node scripts/coord.mjs heartbeat",
    "coord:reclaim": "node scripts/coord.mjs reclaim-stale",
    "coord:migration": "node scripts/coord.mjs migration",
    "coord:migration:reserve": "node scripts/coord.mjs migration reserve",
    "coord:migration:list": "node scripts/coord.mjs migration list",
    "coord:migration:release": "node scripts/coord.mjs migration release",
    "coord:test": "node scripts/coord-core.test.mjs && node scripts/coord-race.test.mjs && node scripts/coord-migration-race.test.mjs",
