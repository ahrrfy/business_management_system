    "db:backup:all-companies": "node scripts/backup.mjs --all-companies",
    "db:ensure-app-user": "node scripts/ensure-db-app-user.mjs",
    "db:migrate:safe": "node scripts/db-migrate-safe.mjs",
    "db:migrate:apply": "node scripts/db-migrate-apply.mjs",
