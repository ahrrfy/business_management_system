    "check:raw-tables": "node scripts/check-raw-tables.mjs",
    "check:window-print": "node scripts/check-window-print.mjs",
    "check:locale-numbers": "node scripts/check-locale-numbers.mjs",
    "check:raw-select": "node scripts/check-raw-select.mjs",
    "check:filter-shell": "node scripts/check-filter-shell.mjs",
