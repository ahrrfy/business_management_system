# قالب بيئة الإنتاج على VPS — انسخه إلى .env واملأ القيم ثم: chmod 600 .env
# توليد قيم قوية:  openssl rand -hex 32
NODE_ENV=production

# الخادم يستمع على الحلقة المحلية فقط — nginx هو العميل الوحيد (لا تكشف 3000 للإنترنت).
HOST=127.0.0.1
# لا تفعّله خلف nginx. يُستخدم فقط إذا كان ربط HOST العام/LAN مقصوداً ومعه جدار ناري؛
# الإنتاج يرفض الإقلاع عند HOST غير loopback من دونه.
ALLOW_PUBLIC_BIND=0
PORT=3000
# سر hop بين nginx وNode على الخادم المشترك؛ نفس القيمة تُوضع في إعداد nginx أدناه.
INTERNAL_PROXY_SECRET=ضع-ناتج-openssl-rand-hex-32
REQUIRE_INTERNAL_PROXY_SECRET=1
# الاستعادة/التصفير عبر الويب معطّلان نهائياً في الإنتاج؛ استخدم CLI بعد إيقاف عمال الويب.

# القاعدة المركزية: منفذ 3307 مميّز (الخادم مشترك — لا نصادم خدمات أخرى)، على الحلقة المحلية فقط.
DB_CONTAINER=erp-mysql
DB_NAME=erp
DB_PORT=3307
DB_ROOT_PW=ضع-كلمة-قوية-هنا
DB_APP_USER=erp_app
DB_APP_PW=ضع-كلمة-مختلفة-قوية-هنا
DATABASE_URL=mysql://erp_app:ضع-كلمة-مختلفة-قوية-هنا@127.0.0.1:3307/erp

# ميزانية اتصالات قاعدة البيانات — الافتراضات الآمنة: عاملان × 10 شركات ساخنة × 5 اتصالات = 100،
# مع احتياطي 20 اتصالاً تحت max_connections=151. التطبيق يرفض بدء ميزانية تتجاوز السعة.
WEB_INSTANCES=2
DB_POOL_LIMIT=5
DB_MAX_TENANT_POOLS_PER_WORKER=10
DB_TENANT_POOL_IDLE_MS=900000
MYSQL_MAX_CONNECTIONS=151
DB_CONNECTION_RESERVE=20
CONTROL_DB_POOL_LIMIT=5

# ذاكرة القاعدة: 2G ملائمة لخادم مشترك 16GB (ترتفع لاحقاً عند نمو البيانات).
DB_BUFFER_POOL=2G
# احتفاظ binlog ٣ أيام (استعادة نقطة-زمنية بين النسخ الليلية بلا التهام القرص).
DB_BINLOG_EXPIRE=259200
# مهلة انتظار قفل الصفوف ١٠ث — لا يتعلّق الكاشير خلف قفل طويل.
DB_LOCK_WAIT=10

# سرّ التوكنات — ٦٤ خانة hex على الأقل، لا تتركه افتراضياً أبداً.
JWT_SECRET=ضع-ناتج-openssl-rand-hex-32

# أول مدير (تُستعمل مرة واحدة عند البذرة seed:prod — كلمة قوية إلزامية).
ADMIN_EMAIL=admin@alroya.local
ADMIN_PASSWORD=ضع-كلمة-قوية-هنا

# أحادي الأصل خلف nginx ⇒ لا حاجة لـCORS (اتركه فارغاً).
ALLOWED_ORIGINS=

# النسخ الاحتياطي
BACKUP_DIR=backups
# رفع الاستعادة دفق SQL مباشر (لا Base64): 200MB ثابت، و3 محاولات/ساعة لكل IP كدفاع
# ثانوي؛ nginx أمام عمال PM2 يطبق العداد المشترك الأشد (alroya_restore).
RESTORE_UPLOAD_RATE_LIMIT_MAX=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
# تشفير النسخ للدفع الخارجي (gpg --symmetric AES256) — إلزامي على الـVPS.
# ⚠️ Escrow: احفظ هذه العبارة (مع DB_ROOT_PW وJWT_SECRET) في مكانين خارج الخادم على الأقل
# (مدير كلمات مرور المالك + ورقة في خزنة المتجر) — يوم يحترق الخادم، بدونها كل النسخ
# الخارجية حبرٌ على ورق. واختبر فكّ نسخة على جهاز المتجر بعد أول نسخة (دليل التعافي §٢).
BACKUP_GPG_PASSPHRASE=
# مجلد نسخ خارجي محلي (USB/قرص ثانٍ) — اختياري؛ السحب من جهاز المتجر هو الطبقة الخارجية الأساسية.
BACKUP_OFFSITE_DIR=

# المراقبة (اختياري): Sentry DSN للخادم
SENTRY_DSN_SERVER=

# ── صور المنتجات على Cloudflare R2 (لا تفعّل قبل اكتمال بوابة الرفع والترحيل) ──
# اترك IMAGE_STORE_DRIVER فارغاً الآن لاستمرار مسار الصور القديم من MySQL. عند الانتقال
# اضبطه r2؛ يفشل الخادم عند الإقلاع إذا كان أي اعتماد أدناه ناقصاً أو غير صالح.
IMAGE_STORE_DRIVER=
R2_ACCOUNT_ID=
R2_IMAGE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# حدود كل worker؛ الإجمالي = WEB_INSTANCES × R2_MAX_CONCURRENCY. لا ترفعها بلا benchmark.
R2_MAX_CONCURRENCY=4
R2_MAX_QUEUE=8
R2_QUEUE_TIMEOUT_MS=2000
R2_CIRCUIT_FAILURE_THRESHOLD=5
R2_CIRCUIT_OPEN_MS=30000
# لا تحفظ R2_CANARY_CONFIRM أو R2_CANARY_CLOUDFLARE_API_TOKEN هنا: كلاهما canary-only ويُمرّر
# مؤقتاً في shell آمنة عند التشغيل (docs/runbooks/r2-image-storage.md)، ولا يقرأهما runtime التطبيق.

# ── تعدّد الشركات (اختياري، معطَّل افتراضياً) ─────────────────────────────
# اتركه فارغاً لبقاء هذا النشر أحادي الشركة كما هو اليوم (بلا أي تغيير سلوكي). لتفعيل عزل
# قاعدة بيانات فعلي لكل شركة على نفس خادم MySQL (شركات شقيقة): اضبط CONTROL_DATABASE_URL
# + INTEGRATIONS_ENCRYPTION_KEY (٦٤ خانة hex عبر openssl rand -hex 32)، ثم شغّل مرّة واحدة
# على الخادم: pnpm control:bootstrap && pnpm company:new <رمز> "<اسم>" --admin-email .. --admin-password ..
DB_CONTROL_NAME=
DB_CONTROL_USER=
DB_CONTROL_PW=
CONTROL_DATABASE_URL=
# إلزامي أيضاً في النشر الأصلي لتشفير أسرار 2FA ورموز أجهزة FCM، حتى دون تعدّد الشركات.
INTEGRATIONS_ENCRYPTION_KEY=
# Release-only independent fingerprint of the decoded 32-byte key. Store this as the
# protected GitHub variable INTEGRATIONS_ENCRYPTION_KEY_SHA256, separate from the secret.
INTEGRATIONS_ENCRYPTION_KEY_SHA256=

# إلزام 2FA للمدير والمشرف في الإنتاج. بوابة الإصدار ترفض القيمة off أو القيمة الفارغة.
TWO_FACTOR_ENFORCEMENT=on

# إشعارات Android الأصلية (FCM HTTP v1). خزّن JSON حساب الخدمة في مدير الأسرار.
SUPER_APP_NATIVE_REQUIRED=1
NATIVE_PUSH_ENVIRONMENT=prod
FCM_PROJECT_ID=
# Release policy accepts a dedicated service account ending in iam.gserviceaccount.com.
# Its private_key_id/private_key are verified by a short-lived Google OAuth exchange.
FCM_SERVICE_ACCOUNT_JSON=

# جسر جهاز الحضور الفيزيائي. الحضور لا يُسجّل من الهاتف؛ الجهاز يدفع حركاته لهذا المنفذ.
HR_DEVICE_BRIDGE=1
HR_DEVICE_PORT=7788
# اربط بعنوان شبكة الحضور الداخلي المحدد متى كان ثابتاً. 0.0.0.0 يحافظ على توافق النشر القديم
# لكنه يتطلب جداراً نارياً وallowlist أدناه؛ لا تعرّض 7788 للإنترنت العام.
HR_DEVICE_HOST=0.0.0.0
# عناوين/CIDR مفصولة بفواصل. إلزامي إنتاجياً ما لم تُستخدم بوابة بسر قوي.
# النطاقان 0.0.0.0/0 و ::/0 وأي CIDR غير صالح مرفوضة حتماً.
# املأه بعنوان المصدر الحقيقي المرصود على الخادم؛ لا تنسخ نطاقاً مثالياً غير مطابق.
HR_DEVICE_IP_ALLOWLIST=
# اختياري للتوافق مع الأجهزة القديمة. فعّله فقط إن أمكن ضبط token في عنوان خادم الجهاز
# أو x-hr-device-secret / Authorization Bearer في بوابة الشبكة. يولّد: openssl rand -hex 32
# الأسرار الدورية/الافتراضية مرفوضة حتى لو بلغ طولها 32 بايت.
HR_DEVICE_SHARED_SECRET=
# ربط اختياري خاص بكل SN عبر JSON؛ مفتاح الجهاز يصل في x-hr-device-key أو deviceKey.
# يمكن أيضاً ضبط IP الجهاز في سجل hrFingerprintDevices؛ وعند اكتشاف جهاز معطّل يُحفظ IP المرصود.
HR_DEVICE_IDENTITY_BINDINGS=
# يجب أن يبقى 0 في الإنتاج. نفّذ اكتشاف/ربط الأجهزة في staging؛ بوابة الإنتاج ترفض 1.
HR_DEVICE_LEGACY_IDENTITY_MIGRATION=0
HR_DEVICE_MAX_PAYLOAD_BYTES=8388608
HR_DEVICE_REQUEST_TIMEOUT_MS=30000
HR_DEVICE_IDLE_TIMEOUT_MS=180000
HR_DEVICE_RATE_LIMIT_PER_MINUTE=240
# رسائل الجلسة بعد نجاح reg — منفصلة عن ميزانية الاتصال أعلاه كي لا يحجب تفريغُ المتراكم
# إعادةَ الاتصال (٣٠٠٠/دقيقة ≈ ٦٠ ألف بصمة/دقيقة).
HR_DEVICE_SESSION_RATE_LIMIT_PER_MINUTE=3000
HR_DEVICE_MAX_WS_PER_IP=4
# إظهار اسم الفرع/الجهاز على شاشة القفل يحتاج قراراً صريحاً؛ false يخفيهما.
ATTENDANCE_PUSH_INCLUDE_WORKPLACE=false

# ── تغليف أندرويد TWA (اختياري — لنشر المتجر على Google Play) ─────────────────────────
# يفعّلان خدمة /.well-known/assetlinks.json التي تربط تطبيق أندرويد بالأصل (يُزيل شريط العنوان).
# TWA_ANDROID_PACKAGE = اسم الحزمة (يطابق packageId في twa/twa-manifest.json).
# TWA_SHA256_CERT_FINGERPRINTS = بصمات SHA-256 مفصولة بفاصلة (مفتاح توقيعك + مفتاح Play App Signing).
# فارغان ⇒ الخدمة تعيد 404 (التغليف غير مُفعَّل). التفصيل: docs/twa-android-setup.md.
TWA_ANDROID_PACKAGE=
TWA_SHA256_CERT_FINGERPRINTS=
